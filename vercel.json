{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [{ "source": "/", "destination": "/site/", "permanent": false }],
  "headers": [
    {
      "source": "/(.*)\.(md|toml|py|txt|lock)",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    }
  ]
}
